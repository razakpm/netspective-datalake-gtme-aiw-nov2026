# Copy to .env for local development. Placeholders only: never commit real values.
# Production values come from the platform secret manager, never from files in this repository.
# Numeric defaults documented in specs/001-project-foundation/research.md (R-14) are hypotheses.

NODE_ENV=development

# Local Postgres started by docker/compose.yaml (development only)
POSTGRES_USER=gtm
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gtm
DATABASE_URL=postgres://gtm:change-me-local-only@localhost:5432/gtm

# Logging
LOG_LEVEL=info

# Feature 002 (accounts, contacts, ICP). Keyed hash for the erasure marker: 32+ characters, secret.
SUPPRESSION_HASH_KEY=change-me-local-only-32-chars-min-0000
# Import limits (hypotheses, configurable)
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000

# Feature 003 (hypothesis defaults)
SIGNAL_EXCERPT_MAX_CHARS=300
SIGNAL_SIMILARITY_THRESHOLD=0.85
SIGNAL_RETENTION_MONTHS=36
SIGNAL_FRESHNESS_JOB_ENABLED=false
SIGNAL_RETENTION_JOB_ENABLED=false
